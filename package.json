{
  "name": "aigentify",
  "version": "0.5.0",
  "description": "Audit and generate agent-native product surfaces",
  "keywords": [
    "agentification",
    "agents",
    "ai",
    "json-ld",
    "mcp"
  ],
  "homepage": "https://github.com/pooriaarab/aigentify",
  "bugs": "https://github.com/pooriaarab/aigentify/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/aigentify.git"
  },
  "bin": {
    "aigentify": "dist/cli.js",
    "aigentify-mcp": "dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "jiti": "^2.5.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.pooriaarab/aigentify"
}
