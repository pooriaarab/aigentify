{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pooriaarab/aigentify",
  "description": "Audit and generate agent-native product surfaces",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/pooriaarab/aigentify",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "aigentify",
      "version": "0.1.1",
      "transport": { "type": "stdio" },
      "runtimeHint": "npx",
      "packageArguments": [
        { "type": "positional", "valueHint": "subcommand", "value": "mcp" }
      ]
    }
  ]
}
